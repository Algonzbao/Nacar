---
import { Image } from "astro:assets";
import logoNacar from "../assets/logoBlanco.png";
---

<nav class="bg-primary text-white fixed w-full z-10">
  <div class="h-16 flex justify-between items-center px-6 py-4 w-full max-w-full">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="text-3xl font-bold flex items-center">
        <Image src={logoNacar} alt="Logo" class="h-12 w-auto mr-2" />
      </a>
    </div>

    <!-- Links visibles en pantallas grandes -->
    <div class="hidden lg:flex items-center">
      <ul class="flex gap-6 xl:gap-8 text-lg xl:text-xl">
        <li>
          <a href="/conocenos" class="hover:text-hoverRosa font-bold">Conoce</a>
        </li>
        <li>
          <a href="/programas" class="hover:text-hoverRosa font-bold">Programas</a>
        </li>
        <li>
          <a href="/mision-vision-valores" class="hover:text-hoverRosa font-bold">
            Misión, Visión y Valores
          </a>
        </li>
        <li>
          <a href="/#plan-corresponsables" class="hover:text-hoverRosa font-bold">
            Plan Corresponsables
          </a>
        </li>
        <li>
          <a href="/contacto" class="hover:text-hoverRosa font-bold">Contacto</a>
        </li>
      </ul>
    </div>

    <!-- Botón del menú hamburguesa en pantallas pequeñas -->
    <div class="lg:hidden">
      <button id="hamburger-button" class="text-2xl focus:outline-none" aria-label="Abrir menú">
        <span class="block w-8 h-1 bg-white mb-2"></span>
        <span class="block w-8 h-1 bg-white mb-2"></span>
        <span class="block w-8 h-1 bg-white"></span>
      </button>
    </div>
  </div>

  <!-- Menú desplegable en pantallas pequeñas -->
  <div
    id="mobileMenu"
    class="font-wreath hidden absolute top-16 left-0 w-full bg-slate-900 text-center p-5 z-50 animate-fade-in-down"
  >
    <ul class="text-xl">
      <li class="my-4">
        <a href="/conocenos" class="block hover:bg-slate-800 py-2 rounded mobileLink">Conoce</a>
      </li>
      <li class="my-4">
        <a href="/programas" class="block hover:bg-slate-800 py-2 rounded mobileLink">Programas</a>
      </li>
      <li class="my-4">
        <a href="/mision-vision-valores" class="block hover:bg-slate-800 py-2 rounded mobileLink">
          Misión, Visión y Valores
        </a>
      </li>
      <li class="my-4">
        <a href="/#plan-corresponsables" class="block hover:bg-slate-800 py-2 rounded mobileLink">
          Plan Corresponsables
        </a>
      </li>
      <li class="my-4">
        <a href="/contacto" class="block hover:bg-slate-800 py-2 rounded mobileLink">Contacto</a>
      </li>
    </ul>
  </div>

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      const hamburgerButton = document.getElementById("hamburger-button");
      const mobileMenu = document.getElementById("mobileMenu");
      hamburgerButton?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
      });
    });
  </script>
</nav>
