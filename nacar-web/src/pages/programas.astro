---
// Guárdala como: nacar-web/src/pages/programas.astro
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// FOTOS (opcional): copia la imagen a src/assets/ (JPG/WebP, máx. 1600 px y ~400 KB,
// sin tildes ni espacios en el nombre), descomenta su import y ponla en "imagen".
// import mayores from "../assets/mayores.jpg";

// TEXTOS: edita solo lo que hay dentro de "intro" y "programas".
// "datos" es opcional: si un programa no lo tiene, ese cuadro no se muestra.
// Ejemplo para añadirlo a un programa:
//   datos: [{ etiqueta: "Dónde", valor: "Buendía" }, { etiqueta: "Financia", valor: "..." }],
const intro = {
  titulo: "Programas para toda la comunidad",
  texto:
    "Además de trabajar con las familias, en Nácar Asociación impulsamos proyectos que mejoran la vida de las personas mayores y de los pueblos de España.",
};

const programas = [
  {
    id: "envejecimiento-activo",
    titulo: "Envejecimiento activo",
    resumen:
      "Actividades para que las personas mayores se mantengan activas, autónomas y conectadas con su comunidad. Combatimos la soledad no deseada y fomentamos una vejez participativa y con calidad de vida.",
    actividades: [
      "Ejercicio físico adaptado",
      "Talleres de memoria y estimulación cognitiva",
      "Encuentros intergeneracionales",
      "Salidas y actividades de ocio compartido",
    ],
    imagen: null, // por ejemplo: mayores
  },
  {
    id: "desarrollo-rural",
    titulo: "Desarrollo rural",
    resumen:
      "Trabajamos desde Buendía y otros pueblos de toda nuestra geografía para que vivir en el medio rural sea una opción con futuro. Colaboramos con ayuntamientos y vecinos para fijar población y fortalecer el tejido social.",
    actividades: [
      "Dinamización comunitaria",
      "Formación y empleo en el medio rural",
      "Igualdad de oportunidades",
      "Servicios y actividades de proximidad",
    ],
    imagen: null,
  },
  {
    id: "digitalizacion-mayores",
    titulo: "Digitalización de mayores",
    resumen:
      "Acercamos la tecnología a las personas mayores con formación práctica y a su ritmo, para que nadie se quede atrás en el mundo digital.",
    actividades: [
      "Uso del móvil, WhatsApp y videollamadas",
      "Cita médica y gestiones con la administración online",
      "Cómo detectar estafas y navegar con seguridad",
      "Atención individual y grupos reducidos",
    ],
    imagen: null,
  },
];
---

<Layout
  title="Programas de envejecimiento activo, desarrollo rural y digitalización - Nácar Asociación"
  description="Programas de Nácar Asociación para personas mayores y para el medio rural en Castilla-La Mancha: envejecimiento activo, desarrollo rural y digitalización de mayores."
>
  <Nav />

  <main class="text-gray-800">
    <header class="bg-primary/30 px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <h1 class="font-wreath text-4xl md:text-6xl text-azul mb-6">{intro.titulo}</h1>
        <p class="max-w-2xl text-lg md:text-xl leading-relaxed mb-8">{intro.texto}</p>
        <nav aria-label="Programas" class="flex flex-wrap gap-3">
          {programas.map((p) => (
            <a
              href={`#${p.id}`}
              class="rounded-full border-2 border-azul px-5 py-2 font-bold text-azul transition hover:bg-azul hover:text-white"
            >
              {p.titulo}
            </a>
          ))}
        </nav>
      </div>
    </header>

    {programas.map((p, i) => (
      <section
        id={p.id}
        aria-labelledby={`${p.id}-titulo`}
        class:list={["scroll-mt-24 px-6 py-14 md:py-20", i % 2 === 1 && "bg-arena/20"]}
      >
        <div class:list={["mx-auto max-w-5xl grid gap-10 items-center", p.imagen && "md:grid-cols-2"]}>
          <div class:list={[p.imagen && i % 2 === 1 && "md:order-2"]}>
            <h2 id={`${p.id}-titulo`} class="font-wreath text-3xl md:text-4xl text-azul mb-4">{p.titulo}</h2>
            <p class="text-lg leading-relaxed mb-6">{p.resumen}</p>

            <h3 class="font-bold text-lg mb-2">Qué hacemos</h3>
            <ul class="list-disc pl-5 space-y-1 mb-6 marker:text-rosa">
              {p.actividades.map((a) => <li>{a}</li>)}
            </ul>

            {p.datos && p.datos.length > 0 && (
              <dl class="mb-8 rounded-lg border-l-4 border-rosa bg-white/70 p-4 space-y-1">
                {p.datos.map((d) => (
                  <div class="flex flex-wrap gap-x-3">
                    <dt class="font-bold">{d.etiqueta}:</dt>
                    <dd>{d.valor}</dd>
                  </div>
                ))}
              </dl>
            )}

            <a
              href="/contacto"
              class="inline-block rounded-lg bg-rosa px-6 py-3 font-bold text-white transition hover:bg-hoverRosa"
            >
              Habla con nosotros
            </a>
          </div>

          {p.imagen && (
            <div class:list={[i % 2 === 1 && "md:order-1"]}>
              <Image src={p.imagen} alt={p.titulo} class="w-full rounded-xl object-cover aspect-[4/3]" />
            </div>
          )}
        </div>
      </section>
    ))}

    <section class="px-6 py-16 text-center bg-primary/30">
      <h2 class="font-wreath text-3xl text-azul mb-3">¿Quieres que llevemos un programa a tu municipio?</h2>
      <p class="mx-auto max-w-xl mb-6 text-lg">
        Cuéntanos qué necesita tu pueblo, tu asociación o tu ayuntamiento y lo diseñamos juntos.
      </p>
      <a
        href="/contacto"
        class="inline-block rounded-lg bg-rosa px-6 py-3 font-bold text-white transition hover:bg-hoverRosa"
      >
        Contacta con Nácar
      </a>
    </section>
  </main>

  <Footer />
</Layout>
