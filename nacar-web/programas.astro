      "Animación infantil y eventos familiares",
      "Educación emocional, igualdad y convivencia",
      "Programas de apoyo a familias",
    ],
  },
  {
    id: "personas-mayores",
    corto: "Personas mayores",
    titulo: "Personas mayores y envejecimiento activo",
    lema: "Autonomía, bienestar y participación",
    pagina: "/programas/personas-mayores",
    programas: [
      "Programas de envejecimiento activo",
      "Prevención de la soledad no deseada",
      "Alfabetización y capacitación digital",
      "Estimulación cognitiva y memoria",
      "Promoción de la autonomía personal",
      "Actividad física adaptada y hábitos saludables",
      "Acompañamiento social y comunitario",
      "Atención Centrada en la Persona (ACP)",
      "Apoyo y formación a personas cuidadoras",
      "Actividades intergeneracionales",
    ],
  },
  {
    id: "desarrollo-rural",
    corto: "Desarrollo rural",
    titulo: "Desarrollo rural y dinamización territorial",
    lema: "Pueblos vivos, comunidades conectadas",
    pagina: "/programas/desarrollo-rural",
    programas: [
      "Programas contra la despoblación",
      "Dinamización sociocultural de municipios",
      "Actividades y servicios para población rural",
      "Programas de participación vecinal",
      "Revitalización de espacios comunitarios",
      "Programas intergeneracionales en el medio rural",
      "Promoción del patrimonio cultural y natural",
      "Educación ambiental y sostenibilidad",
      "Impulso del asociacionismo rural",
      "Proyectos de cohesión territorial",
    ],
  },
  {
    id: "inclusion-igualdad",
    corto: "Inclusión e igualdad",
    titulo: "Inclusión social e igualdad",
    lema: "Oportunidades para todas las personas",
    programas: [
      "Programas de inclusión social",
      "Atención a colectivos vulnerables",
      "Igualdad de oportunidades y diversidad",
      "Prevención de la violencia y discriminación",
      "Inclusión de personas con discapacidad",
      "Participación e integración comunitaria",
      "Programas de interculturalidad",
      "Accesibilidad e inclusión digital",
    ],
  },
  {
    id: "formacion-empleo",
    corto: "Formación y empleo",
    titulo: "Formación, empleo y capacitación",
    lema: "Competencias para nuevas oportunidades",
    programas: [
      "Formación presencial y teleformación",
      "Cursos y talleres para administraciones",
