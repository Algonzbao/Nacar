---

<Layout
  title="Programas y servicios - Nácar Asociación"
  description="Programas y servicios de Nácar Asociación para ayuntamientos, diputaciones y entidades: infancia y familias, personas mayores, desarrollo rural, inclusión, formación, consultoría y participación comunitaria."
>
  <Nav />

  <main class="text-gray-800">
    <header class="bg-primary/30 px-6 pt-28 pb-16 md:pt-32 md:pb-20">
      <div class="mx-auto max-w-5xl">
        <h1 class="font-wreath text-4xl md:text-6xl text-azul mb-6">{intro.titulo}</h1>
        <p class="max-w-2xl text-lg md:text-xl leading-relaxed mb-8">{intro.texto}</p>
        <nav aria-label="Áreas de programas" class="flex flex-wrap gap-3">
          {areas.map((a) => (
            <a
              href={`#${a.id}`}
              class="rounded-full border-2 border-azul px-4 py-2 font-bold text-azul transition hover:bg-azul hover:text-white"
            >
              {a.corto}
            </a>
          ))}
        </nav>
      </div>
    </header>

    {areas.map((a, i) => (
      <section
        id={a.id}
        aria-labelledby={`${a.id}-titulo`}
        class:list={["scroll-mt-24 px-6 py-14 md:py-16", i % 2 === 1 && "bg-arena/20"]}
      >
        <div class="mx-auto max-w-5xl grid gap-8 md:grid-cols-3">
          <div>
            <h2 id={`${a.id}-titulo`} class="font-wreath text-3xl text-azul mb-3">{a.titulo}</h2>
            <p class="text-lg italic mb-6">{a.lema}</p>
            <a
              href="/contacto"
              class="inline-block rounded-lg bg-rosa px-5 py-3 font-bold text-white transition hover:bg-hoverRosa"
            >
              Solicita una propuesta
            </a>
                      {a.pagina && (
              <a href={a.pagina} class="mt-4 block font-bold text-azul underline hover:text-rosa">
                Más información →
              </a>
            )}
          </div>

          <ul class="md:col-span-2 md:columns-2 gap-x-8 list-disc pl-5 marker:text-rosa">
            {a.programas.map((p) => (
              <li class="break-inside-avoid py-1 leading-snug">{p}</li>
            ))}
          </ul>
        </div>
      </section>
    ))}

    <section class="px-6 py-16 text-center bg-primary/30">
      <h2 class="font-wreath text-3xl text-azul mb-3">Cuéntanos las necesidades de tu municipio</h2>
      <p class="mx-auto max-w-xl mb-6 text-lg">
        Diseñamos la propuesta técnica y económica que mejor se adapte a tu ayuntamiento, diputación o entidad.
      </p>
      <a
        href="/contacto"
        class="inline-block rounded-lg bg-rosa px-6 py-3 font-bold text-white transition hover:bg-hoverRosa"
      >
        Solicita una propuesta técnica y económica
      </a>
    </section>
  </main>

  <Footer />
</Layout>
